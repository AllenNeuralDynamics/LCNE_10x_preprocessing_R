#!/usr/bin/env bash
set -euo pipefail

# LCNE 10x snRNA-seq Preprocessing Pipeline
# Sequential execution of R scripts for LC-NE cell identification and analysis

echo "=== LCNE 10x Preprocessing Pipeline ==="
echo "Started at $(date)" d
echo ""

# Validate required data assets
if [[ ! -d "/scratch/nemo_download" ]]; then
  bash /code/download_nemo_data.sh
fi

echo "✓ Data assets verified"
echo ""

# Create output directories
mkdir -p /results/figures /results/objects /scratch

# Change to code directory
cd /code

# Disable renv for reproducible runs (packages installed globally in Dockerfile)
if [[ -f .Rprofile ]]; then
  mv .Rprofile .Rprofile.disabled
fi

# Step 1: Build full Seurat object with QC and batch correction
echo "[1/6] Building full Seurat object with Harmony batch correction..."
Rscript --vanilla 01_build_full_object.R
echo "✓ Step 1 complete: LC_clustered_harmony.rds saved"
echo ""

# Step 2: Define LC population from clusters
echo "[2/6] Defining LC-NE population from clusters..."
Rscript --vanilla 02_define_LC_population.R
echo "✓ Step 2 complete: LC population identified"
echo ""

# Step 3: LC subclustering and outlier removal
echo "[3/6] LC subclustering and outlier removal..."
Rscript --vanilla 03_LC_subclustering.R
echo "✓ Step 3 complete: LC cells refined"
echo ""

# Step 4: Generate publication figures
echo "[4/6] Generating publication figures..."
Rscript --vanilla 04_publication_fig.R
echo "✓ Step 4 complete: Figures saved to /results/figures"
echo ""

# Step 5: Export to h5ad format for Python analysis
echo "[5/6] Exporting LC subset to h5ad format..."
Rscript --vanilla 05_export_LC_to_h5ad.R
echo "✓ Step 5 complete: H5AD file saved"
echo ""

# Step 6: Retro-seq conversion
echo "[6/6] Running retro-seq conversion..."
Rscript --vanilla 06_retroseq_convert.R
echo "✓ Step 6 complete: Retro-seq conversion done"
echo ""

# Restore .Rprofile for Cloud Workstation compatibility
if [[ -f .Rprofile.disabled ]]; then
  mv .Rprofile.disabled .Rprofile
fi

echo "=== Pipeline Complete ==="
echo "Finished at $(date)"
echo ""
echo "Output files written to /results/"
ls -lh /results/ 2>/dev/null || echo "(No result files found)"
